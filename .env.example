# =============================================================================
# AI Document Analyzer - Environment Configuration
# =============================================================================

# AWS CLI Credentials & Region
AWS_PROFILE=default
AWS_REGION=us-east-1
# AWS_ACCOUNT_ID=123456789012 # Optional: leave commented to auto-detect via STS

# Amazon Bedrock AI Model Selection (Ultra-low cost models only)
# Option 1 (Recommended): Amazon Nova Micro ($0.000035/1k input, $0.00014/1k output tokens)
BEDROCK_MODEL_ID=amazon.nova-micro-v1:0

# Option 2: Anthropic Claude 3 Haiku ($0.00025/1k input, $0.00125/1k output tokens)
# BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0

# Hard Budget Threshold Guardrail (USD)
BUDGET_LIMIT=10
ALERT_EMAIL=alerts@yourdomain.com

# Logging
LOG_LEVEL=INFO
